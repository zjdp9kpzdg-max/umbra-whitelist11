# Visitors never enter these. Project owner sets them in .env.local
# or the host (Vercel project settings). Never paste secrets into the
# site UI or into chat with an assistant.

# App-only Bearer Token — optional.
# Resolves a handle and can check retweeted_by (and liking_users if X allows).
# CANNOT power Connect X / Sign in with X.
TWITTER_BEARER_TOKEN=

# OAuth 2.0 client credentials — required for true Connect X.
# Developer Portal → User authentication settings → OAuth 2.0.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Must match Developer Portal. Path is always /api/auth/twitter/callback
TWITTER_CALLBACK_URL=http://127.0.0.1:43147/api/auth/twitter/callback

# Public quest post id (not a secret). TBD until @UMBRAStudio11 posts the Coming Soon RT.
# Example: for https://x.com/UMBRAStudio11/status/1234567890123456789 use 1234567890123456789
TARGET_TWEET_ID=

# Cookie encryption. At least 32 characters. Hosting only — never in the UI.
SESSION_SECRET=replace-with-a-long-random-secret-32+

# SQLite file (default) or Postgres.
# SQLite: file:./data/umbra.sqlite
# Postgres: postgres://user:pass@localhost:5432/umbra
DATABASE_URL=file:./data/umbra.sqlite

# CSV export. Send as ADMIN_TOKEN or x-admin-token header. Hosting only.
ADMIN_TOKEN=replace-with-admin-export-token
